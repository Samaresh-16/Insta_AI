# Environment Variables for AI Video Pipeline
# Copy to .env and fill in your values
# Never commit this file!

# Higgsfield API
HIGGSFIELD_API_KEY=your-higgsfield-api-key-here
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai/v1
HIGGSFIELD_MODEL=higgsfield-video-v1

# Instagram / Meta Graph API
INSTAGRAM_APP_ID=your-meta-app-id
INSTAGRAM_APP_SECRET=your-meta-app-secret
INSTAGRAM_ACCESS_TOKEN=your-long-lived-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_REFRESH_TOKEN=your-refresh-token (optional)

# Optional: Override pipeline settings
# PIPELINE_VIDEO_OUTPUT_DIR=./output/videos
# PIPELINE_MAX_DURATION_SECONDS=60
# PIPELINE_DEFAULT_ASPECT_RATIO=9:16